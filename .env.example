# ========================================================================
# UNO Classic Real-Time Multiplayer Environment Variables
# ========================================================================

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (Public key for client-side realtime subscriptions)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (CONFIDENTIAL! Server-side only, NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional base URL for public invitations (defaults to window.location.origin)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
