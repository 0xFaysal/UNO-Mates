# UNO Mates — copy to .env.local; never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Use ONE public key. Prefer a publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# For a legacy anon key, remove the publishable line above and use:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server only. Never add NEXT_PUBLIC_ to this name.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Alternative: SUPABASE_SECRET_KEY=your-server-secret-key

# Production website origin for metadata/social previews.
# Invitation links use the current browser origin automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
